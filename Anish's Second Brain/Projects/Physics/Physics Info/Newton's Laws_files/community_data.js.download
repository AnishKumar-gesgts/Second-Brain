,post_data : {"post_id":2715929,"post_type":"forum","topic_id":484712,"poster_id":60735,"post_rendered":"Let <img src=\"\/\/latex.artofproblemsolving.com\/a\/5\/b\/a5b29b358e825defa3e11b7d903d43ec31e5909a.png\" class=\"latex\" alt=\"$a,b,c$\" style=\"vertical-align: -3px\" width=\"41\" height=\"16\" > be real numbers that satisfy <img src=\"\/\/latex.artofproblemsolving.com\/0\/9\/3\/093a3896a4b0604d15b2759aacbbc3e427e019b3.png\" class=\"latex\" alt=\"$\\frac{1}{a+b}+\\frac{1}{b+c}+\\frac{1}{a+c} =1$\" style=\"vertical-align: -14px\" width=\"206\" height=\"38\" > and <span style=\"white-space:nowrap;\"><img src=\"\/\/latex.artofproblemsolving.com\/c\/f\/e\/cfe5df569039fa7822c5179d773272fda1d94f5a.png\" class=\"latex\" alt=\"$ab+bc+ac &gt;0$\" style=\"vertical-align: -1px\" width=\"127\" height=\"14\" >.<\/span><br>\n<br>\nShow that <img src=\"\/\/latex.artofproblemsolving.com\/4\/8\/8\/488322c894c01f6a9e2950e289000312f3b0ecff.png\" class=\"latexcenter\" alt=\"\\[ a+b+c - \\frac{abc}{ab+bc+ac} \\ge 4 \\]\"  width=\"223\" height=\"38\" >","post_canonical":"Let $a,b,c$ be real numbers that satisfy $\\frac{1}{a+b}+\\frac{1}{b+c}+\\frac{1}{a+c} =1$ and $ab+bc+ac >0$.\n\nShow that \\[ a+b+c - \\frac{abc}{ab+bc+ac} \\ge 4 \\]","username":"hatchguy","post_number":1,"post_format":"bbcode","category_name":"High School Olympiads","category_id":6,"poster_avatar":"\/\/avatar.artofproblemsolving.com\/avatar_60735.png"}});
