,post_data : {"post_id":31815941,"post_type":"forum","topic_id":3390081,"poster_id":167643,"post_rendered":"Prove that if <img src=\"\/\/latex.artofproblemsolving.com\/7\/3\/4\/7340bcdc8e90b1eb712600b4c59ade538be254ae.png\" class=\"latex\" alt=\"$ n $\"  width=\"10\" height=\"8\" > is a natural number greater than <span style=\"white-space:pre;\"><img src=\"\/\/latex.artofproblemsolving.com\/a\/b\/f\/abf6cc59c3c79b1d97ae8d95af17677d807f277d.png\" class=\"latex\" alt=\"$ 2 $\"  width=\"8\" height=\"12\" >,<\/span> then <img src=\"\/\/latex.artofproblemsolving.com\/0\/8\/3\/0832d792209a3a0d8d7ea8398015333d0fc1cb6b.png\" class=\"latexcenter\" alt=\"$$\\sqrt[n + 1]{n+1} &lt; \\sqrt[n]{n}.$$\"  width=\"124\" height=\"19\" >","post_canonical":"Prove that if $ n $ is a natural number greater than $ 2 $, then $$\\sqrt[n + 1]{n+1} < \\sqrt[n]{n}.$$","username":"parmenides51","post_number":1,"post_format":"bbcode","category_name":"Old High School Olympiads","category_id":1068820,"poster_avatar":"\/\/avatar.artofproblemsolving.com\/avatar_167643.png?t=1472410314"}});
